# Firebase Realtime Database / auth
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=

# Optional: only needed for legacy books still stored in Firebase Storage
FIREBASE_STORAGE_BUCKET=

# Cloudflare R2 ebook storage
BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# App / security
PUBLIC_ORIGIN=https://mstech-ebook.store
AUTH_SESSION_SECRET=
ADMIN_SETUP_KEY=
ADMIN_TOTP_SECRET=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Password reset email
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /books/{bookId}/{fileName}{allow read:if request.auth!=null&&firestore.get(/databases/(default)/documents/purchases/$(request.auth.uid + "_" + bookId)).data.status=="PAID";allow write:if request.auth!=null&&request.auth.token.admin==true;}
  match /covers/{fileName}{allow read:if true;allow write:if request.auth!=null&&request.auth.token.admin==true;}
 }
}